{
  "properties": [
    {
      "name": "mozhno.url",
      "type": "java.lang.String",
      "description": "URL of the mozhno server."
    },
    {
      "name": "mozhno.api-key",
      "type": "java.lang.String",
      "description": "API key for authentication."
    },
    {
      "name": "mozhno.app-name",
      "type": "java.lang.String",
      "description": "Name of this application."
    },
    {
      "name": "mozhno.instance-id",
      "type": "java.lang.String",
      "description": "Unique instance identifier."
    },
    {
      "name": "mozhno.environment",
      "type": "java.lang.String",
      "description": "Environment name for the context."
    },
    {
      "name": "mozhno.fetch-toggles-interval",
      "type": "java.lang.Integer",
      "description": "How often to fetch toggles in seconds.",
      "defaultValue": 15
    },
    {
      "name": "mozhno.send-metrics-interval",
      "type": "java.lang.Integer",
      "description": "How often to send metrics in seconds.",
      "defaultValue": 60
    },
    {
      "name": "mozhno.disable-metrics",
      "type": "java.lang.Boolean",
      "description": "Disable metrics reporting.",
      "defaultValue": false
    },
    {
      "name": "mozhno.synchronous-fetch",
      "type": "java.lang.Boolean",
      "description": "Fetch toggles synchronously on startup.",
      "defaultValue": false
    }
  ]
}
