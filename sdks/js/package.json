{
  "name": "@mozhno/client-js",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/mozhno-client.cjs",
  "module": "./dist/mozhno-client.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mozhno-client.mjs",
      "require": "./dist/mozhno-client.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": ["feature-flags", "feature-toggles", "mozhno", "sdk"],
  "license": "AGPL-3.0",
  "devDependencies": {
    "vite": "6.3.5",
    "vitest": "^4.1.8",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.4.0",
    "eslint-config-prettier": "^10.0.0"
  }
}
