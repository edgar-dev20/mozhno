{
  "name": "01-rollout-bucketing",
  "flags": [
    { "name": "Empty ctx", "key": "tf-empty", "enabled": true,
      "activation": { "rollOut": 50 } },
    { "name": "User ctx", "key": "tf-user", "enabled": true,
      "activation": { "rollOut": 50 } },
    { "name": "Anon ctx", "key": "tf-anon", "enabled": true,
      "activation": { "rollOut": 50 } },
    { "name": "Session ctx", "key": "tf-sess", "enabled": true,
      "activation": { "rollOut": 50 } },
    { "name": "Fractional", "key": "frac", "enabled": true,
      "activation": { "rollOut": 4 } },
    { "name": "Full rollout", "key": "full-flag", "enabled": true,
      "activation": { "rollOut": 100 } },
    { "name": "Zero rollout", "key": "off-flag", "enabled": true,
      "activation": { "rollOut": 0 } },
    { "name": "No activation", "key": "noact-flag", "enabled": true,
      "activation": {} },
    { "name": "Null activation", "key": "nullact-flag", "enabled": true },
    { "name": "Disabled", "key": "disabled-flag", "enabled": false,
      "activation": { "rollOut": 100 } }
  ],
  "tests": [
    { "name": "bucket('tf-empty')=58; 58<59 true", "flag": "tf-empty",
      "context": {}, "rollOut": 59, "expected": true },
    { "name": "boundary bucket 58: 58<58 false", "flag": "tf-empty",
      "context": {}, "rollOut": 58, "expected": false },
    { "name": "bucket 58; 58<50 false", "flag": "tf-empty",
      "context": {}, "expected": false },
    { "name": "bucket('tf-useruser-1')=31; 31<32 true", "flag": "tf-user",
      "context": { "userId": "user-1" }, "rollOut": 32, "expected": true },
    { "name": "boundary bucket 31: 31<31 false", "flag": "tf-user",
      "context": { "userId": "user-1" }, "rollOut": 31, "expected": false },
    { "name": "bucket 31; 31<50 true", "flag": "tf-user",
      "context": { "userId": "user-1" }, "expected": true },
    { "name": "bucket('tf-anonanon-1')=99; 99<100 true", "flag": "tf-anon",
      "context": { "anonymousId": "anon-1" }, "rollOut": 100, "expected": true },
    { "name": "boundary bucket 99: 99<99 false", "flag": "tf-anon",
      "context": { "anonymousId": "anon-1" }, "rollOut": 99, "expected": false },
    { "name": "bucket 99; 99<50 false", "flag": "tf-anon",
      "context": { "anonymousId": "anon-1" }, "expected": false },
    { "name": "sessionId fallback bucket('tf-sessanon-1')=71; 71<72 true", "flag": "tf-sess",
      "context": { "sessionId": "anon-1" }, "rollOut": 72, "expected": true },
    { "name": "boundary sessionId bucket 71: 71<71 false", "flag": "tf-sess",
      "context": { "sessionId": "anon-1" }, "rollOut": 71, "expected": false },
    { "name": "userId wins over sessionId/anonymousId", "flag": "tf-user",
      "context": { "userId": "user-1", "sessionId": "x", "anonymousId": "anon-1" },
      "rollOut": 32, "expected": true },
    { "name": "fractional 3.5 trunc: bucket('frac135')=3; 3<trunc(3.5)=3 false", "flag": "frac",
      "context": { "userId": "135" }, "rollOut": 3.5, "expected": false },
    { "name": "fractional 4: bucket 3<4 true", "flag": "frac",
      "context": { "userId": "135" }, "expected": true },
    { "name": "rollout 100 always true (>=100 shortcut)", "flag": "full-flag",
      "context": {}, "expected": true },
    { "name": "rollout 0 always false (<=0 shortcut)", "flag": "off-flag",
      "context": { "userId": "user-1" }, "expected": false },
    { "name": "empty activation => true", "flag": "noact-flag",
      "context": {}, "expected": true },
    { "name": "null activation => true", "flag": "nullact-flag",
      "context": {}, "expected": true },
    { "name": "disabled flag => false even with rollout 100", "flag": "disabled-flag",
      "context": {}, "expected": false }
  ]
}
