# ============================================================================
# Mozhno configuration (.env.example)
# ----------------------------------------------------------------------------
# Copy to `.env` and adjust. All application settings are driven by MOZHNO_*
# environment variables. Values shown are the built-in defaults unless marked
# REQUIRED. Only variables you want to override need to be present.
# Relaxed binding: MOZHNO_A_B_C  ->  mozhno.a.b.c
# ============================================================================

# --- JWT secret -----------------------------------------------------------
# Base64 signing secret, >= 32 bytes decoded. Generate: openssl rand -base64 32
# OPTIONAL for dev — a random key is generated on startup if left empty.
# WARNING: a random key invalidates all tokens on restart; set explicitly in
# production so tokens survive redeploys.
MOZHNO_JWT_SECRET=

# --- Database -------------------------------------------------------------
MOZHNO_DB_URL=jdbc:postgresql://localhost:5432/feature_flags
MOZHNO_DB_USERNAME=flags_user
MOZHNO_DB_PASSWORD=flags_password
MOZHNO_DB_POOL_MAX_SIZE=20
MOZHNO_DB_POOL_MIN_IDLE=5
MOZHNO_DB_POOL_CONNECTION_TIMEOUT=10000
MOZHNO_DB_POOL_LEAK_DETECTION=30000
MOZHNO_DB_POOL_IDLE_TIMEOUT=600000
MOZHNO_DB_POOL_MAX_LIFETIME=1800000

# --- Flyway migrations ----------------------------------------------------
MOZHNO_FLYWAY_ENABLED=true
MOZHNO_FLYWAY_LOCATIONS=classpath:db/migration

# --- Server / app ---------------------------------------------------------
MOZHNO_SERVER_PORT=8080
MOZHNO_BASE_URL=http://localhost:8080
MOZHNO_UPLOAD_MAX_FILE_SIZE=2MB
# Forwarded-headers handling. `native` (default) trusts X-Forwarded-* only from
# trusted proxies (Tomcat RemoteIpValve; private ranges by default). Use `none`
# to ignore forwarded headers entirely. If your reverse proxy runs on a public
# IP, also set server.tomcat.remoteip.internal-proxies to its address range.
MOZHNO_FORWARD_HEADERS_STRATEGY=native

# --- JWT ------------------------------------------------------------------
MOZHNO_JWT_ISSUER=mozhno
MOZHNO_JWT_ACCESS_TOKEN_TTL_MINUTES=15
MOZHNO_JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Security -------------------------------------------------------------
MOZHNO_SECURITY_BCRYPT_STRENGTH=12
MOZHNO_SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=5
MOZHNO_SECURITY_LOCKOUT_DURATION_MINUTES=15
# Comma-separated allowed CORS origins (empty disables cross-origin credentials)
MOZHNO_SECURITY_CORS_ALLOWED_ORIGINS=

# --- Rate limiting (bucket: capacity / refill-tokens / refill-minutes) ----
MOZHNO_SECURITY_RATE_LIMIT_ENABLED=true
# Examples (uncomment to override):
# MOZHNO_SECURITY_RATE_LIMIT_LOGIN_CAPACITY=10
# MOZHNO_SECURITY_RATE_LIMIT_LOGIN_REFILL_TOKENS=10
# MOZHNO_SECURITY_RATE_LIMIT_LOGIN_REFILL_MINUTES=1

# --- Auth tokens ----------------------------------------------------------
MOZHNO_AUTH_PASSWORD_RESET_TOKEN_TTL_HOURS=1
MOZHNO_AUTH_PASSWORD_RESET_COOLDOWN_MINUTES=5
MOZHNO_AUTH_INVITE_TOKEN_TTL_DAYS=7

# --- Audit ----------------------------------------------------------------
MOZHNO_AUDIT_RETENTION_DAYS=365

# --- Email (SMTP transport) ----------------------------------------------
MOZHNO_SMTP_HOST=localhost
MOZHNO_SMTP_PORT=587
MOZHNO_SMTP_USERNAME=
MOZHNO_SMTP_PASSWORD=
MOZHNO_MAIL_FROM=noreply@mozhno.dev

# --- SDK clients ----------------------------------------------------------
MOZHNO_CLIENT_MAX_METRICS_PER_KEY=1000
MOZHNO_CLIENT_MAX_METRICS_BATCH_SIZE=1000
MOZHNO_CLIENT_INSTANCE_RETENTION_DAYS=30

# --- Webhooks -------------------------------------------------------------
MOZHNO_WEBHOOK_CONNECT_TIMEOUT_SECONDS=10
MOZHNO_WEBHOOK_REQUEST_TIMEOUT_SECONDS=30
MOZHNO_WEBHOOK_ASYNC_CORE_POOL_SIZE=4
MOZHNO_WEBHOOK_ASYNC_MAX_POOL_SIZE=16
MOZHNO_WEBHOOK_ASYNC_QUEUE_CAPACITY=100

# --- Metrics async executor -----------------------------------------------
MOZHNO_METRICS_ASYNC_POOL_CORE_SIZE=2
MOZHNO_METRICS_ASYNC_POOL_MAX_SIZE=4
MOZHNO_METRICS_ASYNC_POOL_QUEUE_CAPACITY=500

# --- Flags ----------------------------------------------------------------
MOZHNO_FLAGS_MAX_TAGS_PER_FLAG=10
MOZHNO_FLAGS_DEFAULT_PAGE_SIZE=50
MOZHNO_FLAGS_MAX_PAGE_SIZE=200
MOZHNO_FLAGS_ENRICHED_MAX_PAGE_SIZE=500

# --- Cache ----------------------------------------------------------------
MOZHNO_CACHE_TYPE=caffeine
MOZHNO_CACHE_TTL_MINUTES=5
MOZHNO_CACHE_MAX_SIZE=5000

# --- Observability / docs -------------------------------------------------
MOZHNO_MANAGEMENT_PORT=9090
MOZHNO_MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
MOZHNO_TRACING_SAMPLE_RATE=1.0
MOZHNO_SWAGGER_ENABLED=true
MOZHNO_SWAGGER_UI_PATH=/swagger-ui.html
MOZHNO_API_DOCS_PATH=/v3/api-docs

# --- Logging --------------------------------------------------------------
MOZHNO_LOG_LEVEL_ROOT=INFO
MOZHNO_LOG_LEVEL_APP=INFO

# ============================================================================
# docker-compose helper vars (Postgres/pgAdmin containers, not the app itself)
# ============================================================================
POSTGRES_DB=feature_flags
POSTGRES_USER=flags_user
POSTGRES_PASSWORD=flags_password
POSTGRES_PORT=5432
APP_PORT=8080
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
